{
  "manifest_version": 3,
  "name": "Bookmark Desk",
  "short_name": "Mark Desk",
  "description": "Organize Chrome bookmarks into a visual new tab page with folders and drag-and-drop sorting.",
  "version": "1.2.22",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/bookmark-16.png",
    "32": "icons/bookmark-32.png",
    "48": "icons/bookmark-48.png",
    "128": "icons/bookmark-128.png"
  }
}
