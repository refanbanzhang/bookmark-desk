{
  "name": "bookmark-desk",
  "private": true,
  "version": "1.2.28",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "zip": "node scripts/package.mjs",
    "release": "npm run build && npm run zip",
    "icons": "for s in 16 32 48 128; do rsvg-convert -w $s -h $s -o public/icons/bookmark-$s.png public/icons/icon.svg; done",
    "shots": "node scripts/store-screenshots.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.30",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "vite": "^8.0.0"
  }
}
